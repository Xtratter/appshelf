<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: всё, кроме вида (тема, прозрачность) — после переустановки он по умолчанию -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ui.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ui.xml" />
    </device-transfer>
</data-extraction-rules>
